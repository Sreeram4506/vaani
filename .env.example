# Local API port used by the Vite development proxy.
PORT=8787

# Keep this enabled while configuring the dashboard. Test calls remain simulated
# and no external provider is contacted.
TEST_MODE=true

# Exotel Programmable Voice (India). Get these from Exotel Dashboard → Settings
# Exotel Programmable Voice. Use 'sg' for api.exotel.com (default/trial accounts) or 'in' for api.in.exotel.com
VOICE_PROVIDER=exotel
EXOTEL_REGION=sg
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=

# Required before TEST_MODE=false: a secure, public bidirectional audio stream
# endpoint for your voice bot, plus an optional status callback endpoint.
EXOTEL_STREAM_URL=wss://your-domain.example/exotel/media
EXOTEL_STATUS_CALLBACK_URL=https://your-domain.example/api/webhooks/exotel

# OpenAI Realtime powers the bidirectional AI conversation over the Exotel stream.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
